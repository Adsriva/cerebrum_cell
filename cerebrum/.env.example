# ── Database ─────────────────────────────────────────────────────
# Netlify DB (Postgres) — provisioned automatically the first time this
# site deploys on Netlify, or the first time `netlify dev` runs against a
# linked site. You do NOT set a connection string yourself; @netlify/database
# reads it from the environment Netlify injects. Nothing to fill in here.

# ── AI (NVIDIA NIM) ──────────────────────────────────────────────
# Server-only. NEVER prefix with NEXT_PUBLIC_.
NVIDIA_API_KEY=YOUR_NVIDIA_NIM_KEY
NVIDIA_MODEL=meta/llama-3.1-70b-instruct

# ── Auth gate ─────────────────────────────────────────────────────
# Checked server-side only, in app/api/auth/route.ts — never shipped to
# the browser bundle. Pick NEW values; do not reuse any password that has
# ever appeared in this repo's source or git history.
MASTER_PASSWORD=YOUR_NEW_MASTER_PASSWORD
NOTEBOOK_DEFAULT_PASSWORD=YOUR_NEW_NOTEBOOK_PASSWORD

# ── Market-data sync (netlify/functions/market-sync-*) ───────────
# INDIANAPI_KEYS — comma-separated x-api-key values for stock.indianapi.in.
# Each free key is capped at 500 calls/month; round-robined with
# auto-failover on 429/401/403.
INDIANAPI_KEYS=YOUR_KEY_1,YOUR_KEY_2,YOUR_KEY_3

# Shared secret the scheduled function sends to the background function,
# so the (publicly reachable) background-function URL can't be triggered
# by anyone else to burn your indianapi.in/NVIDIA quota. Any random string.
SYNC_TRIGGER_SECRET=YOUR_RANDOM_SECRET
